# BotStrike bridge + trading engine (paper mode autostart) — systemd unit
# Install: sudo cp deploy/botstrike-bridge.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now botstrike-bridge
[Unit]
Description=BotStrike trading bridge (FastAPI :9420) + engine autostart
After=network-online.target chrony.service
Wants=network-online.target
# Crash-loop guard: the bridge exits with code 3 when the in-process engine watchdog gives up
# (5 attempts / 10 min). Allow up to 10 service restarts per 10 min before systemd stops retrying.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=botstrike
Group=botstrike
WorkingDirectory=/opt/botstrike/app
EnvironmentFile=/opt/botstrike/app/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
# No __pycache__ writes: the app must only write under data/ and logs/ (see ReadWritePaths)
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BOTSTRIKE_HOST=0.0.0.0
Environment=BOTSTRIKE_PORT=9420
# paper | dry_run | (empty = wait for the desktop to click Start). NEVER "live" here.
Environment=BOTSTRIKE_AUTOSTART=paper
# LIVE feed + execution venue. Historical data (daily bars for the trend signal, backtests)
# stays on Binance/Yahoo regardless — Strike only has 168 days of klines.
Environment=BOTSTRIKE_AUTOSTART_EXCHANGE=strike
# Deploy-level kill switch (audit R2 security_supply-03): with this at 0 the bridge refuses
# mode=live with 403 even when presented a VALID token, so a leaked token cannot trade real money.
# Independent of the regulatory blocker (Binance is reduce-only for ES residents since 1-jul-2026).
Environment=BOTSTRIKE_ALLOW_LIVE=0
ExecStart=/opt/botstrike/app/.venv/bin/python -m server.bridge --host ${BOTSTRIKE_HOST} --port ${BOTSTRIKE_PORT}
Restart=always
RestartSec=10
# Give the engine time to flush metrics / end DB session on stop
TimeoutStopSec=30
KillSignal=SIGTERM
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# Runtime write paths (audit 03 section c): data/ (sqlite db+wal+shm, binance klines parquet,
# catalog.json), logs/ (metrics.jsonl + rotation). /tmp is covered by PrivateTmp. Nothing else.
ReadWritePaths=/opt/botstrike/app/data /opt/botstrike/app/logs
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
