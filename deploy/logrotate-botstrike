# /etc/logrotate.d/botstrike — rotate engine JSONL logs (metrics.jsonl grows ~50 MB/day).
# copytruncate: the engine keeps the file handle open; truncating in place is safe for append-only JSONL.
/opt/botstrike/app/logs/*.jsonl /opt/botstrike/app/logs/*.log {
    daily
    rotate 14
    maxsize 200M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su botstrike botstrike
}
