# BotStrike ops monitor: one-shot, fired by botstrike-monitor.timer every 15 min.
# Watches health / daily trend run / risk halts / journal errors and reports by Telegram
# (scripts/ops_monitor.py). Needs the botstrike user in the systemd-journal group (install.sh).
[Unit]
Description=BotStrike ops monitor (health, daily trend run, risk halts, journal errors to Telegram)
After=botstrike-bridge.service

[Service]
Type=oneshot
User=botstrike
Group=botstrike
WorkingDirectory=/opt/botstrike/app
EnvironmentFile=/opt/botstrike/app/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/botstrike/app/.venv/bin/python /opt/botstrike/app/scripts/ops_monitor.py
